# Draco Dataset Studio — Environment Configuration
# Copy this to .env and fill in your values.
# .env is git-ignored — never commit API keys.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./draco.db

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=./data/storage
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=draco_embeddings

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=18082
DEBUG=true
LOG_LEVEL=INFO
# Set to true only when running behind a reverse proxy or in Docker.
# Default false rejects any request not from 127.0.0.1 / ::1.
ALLOW_REMOTE_ACCESS=false

# ── Workers ───────────────────────────────────────────────────────────────────
MAX_WORKERS=4
GPU_TASK_CONCURRENCY=1

# ── Thumbnails ────────────────────────────────────────────────────────────────
THUMBNAIL_SIZE=512
THUMBNAIL_SMALL_SIZE=128

# ── Secret key (REQUIRED to store provider API keys in the database) ─────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DRACO_SECRET_KEY=change_me_to_a_random_secret

# ── Provider API keys (all optional) ─────────────────────────────────────────
# GEMINI_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# REPLICATE_API_KEY=your_key_here
# FAL_API_KEY=your_key_here

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# ── InsightFace ───────────────────────────────────────────────────────────────
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_THRESH=0.5
INSIGHTFACE_CTX_ID=0

# ── Duplicate detection thresholds ───────────────────────────────────────────
PHASH_THRESHOLD=8
SIMILARITY_THRESHOLD=0.95
FACE_SIMILARITY_THRESHOLD=0.80

# ── Quality scoring weights (must sum to ~1.0) ────────────────────────────────
QUALITY_WEIGHT_SHARPNESS=0.20
QUALITY_WEIGHT_FACE=0.20
QUALITY_WEIGHT_AESTHETIC=0.15
QUALITY_WEIGHT_BRIGHTNESS=0.10
QUALITY_WEIGHT_CONTRAST=0.10
QUALITY_WEIGHT_SATURATION=0.05
QUALITY_WEIGHT_FACE_CENTER=0.10
QUALITY_WEIGHT_BACKGROUND=0.05
QUALITY_WEIGHT_RESOLUTION=0.05
