{
  "name": "draco-dataset-studio",
  "version": "5.0.0",
  "description": "AI-powered dataset curation platform for LoRA training",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "postinstall": "echo Dependencies installed"
  },
  "author": "Draco Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.5.0"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "build": {
    "appId": "com.draco.dataset-studio",
    "productName": "Draco Dataset Studio",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "DRACO_Dataset_Studio_v4.html",
      "python/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "python/",
        "to": "python/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/face-api-weights/",
        "to": "face-api-weights/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true
  }
}
