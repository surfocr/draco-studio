{
  "name": "draco-dataset-studio",
  "version": "6.0.0",
  "description": "AI-powered dataset curation platform for LoRA training",
  "scripts": {
    "start": "python scripts/run_local_app.py",
    "start:win": "run-portable.bat",
    "dev": "python scripts/run_local_app.py --reload",
    "dev:manual": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python scripts/run_backend.py --reload",
    "start:backend": "python scripts/run_backend.py",
    "test:backend": "python scripts/run_backend_tests.py",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test -- --run",
    "lint:frontend": "npm --prefix frontend run lint",
    "postinstall": "echo Dependencies installed"
  },
  "author": "Draco Studio",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
