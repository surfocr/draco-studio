{
  "name": "draco-dataset-studio",
  "version": "5.0.0",
  "description": "AI-powered dataset curation platform for LoRA training",
  "main": "src/main/main.js",
  "scripts": {
    "start": "python scripts/run_local_app.py",
    "start:win": "run-portable.bat",
    "dev": "python scripts/run_local_app.py --reload",
    "dev:manual": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python scripts/run_backend.py --reload",
    "start:backend": "python scripts/run_backend.py",
    "test:backend": "python scripts/run_backend_tests.py",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test -- --run",
    "lint:frontend": "npm --prefix frontend run lint",
    "desktop:start": "node scripts/desktop_entry.js start",
    "desktop:dev": "node scripts/desktop_entry.js dev",
    "desktop:build": "node scripts/desktop_entry.js build",
    "desktop:build:win": "node scripts/desktop_entry.js build:win",
    "postinstall": "echo Dependencies installed"
  },
  "author": "Draco Studio",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.5.0"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "build": {
    "appId": "com.draco.dataset-studio",
    "productName": "Draco Dataset Studio",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "DRACO_Dataset_Studio_v4.html",
      "DRACO_Dataset_Studio_v5.html",
      "python/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "python/",
        "to": "python/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/face-api-weights/",
        "to": "face-api-weights/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true
  }
}
