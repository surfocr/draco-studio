# Draco Dataset Studio backend example environment for local development.
# Copy to backend/.env if you prefer to keep backend settings local to backend/.

DATABASE_URL=sqlite+aiosqlite:///./draco.db
DATA_DIR=./data
STORAGE_PATH=./data/storage
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=draco_embeddings
QDRANT_FACE_COLLECTION=draco_face_embeddings

HOST=127.0.0.1
PORT=18082
DEBUG=true
LOG_LEVEL=INFO
ALLOW_REMOTE_ACCESS=false

MAX_WORKERS=4
GPU_TASK_CONCURRENCY=1
VRAM_BUDGET_MB=4096

THUMBNAIL_SIZE=512
THUMBNAIL_SMALL_SIZE=128

# Required if you want to save provider API keys through the UI.
DRACO_SECRET_KEY=change_me_to_a_random_secret

# Optional provider settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_KEY=
FAL_API_KEY=
OPENROUTER_API_KEY=

INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_THRESH=0.5
INSIGHTFACE_CTX_ID=0

FASTEMBED_MODEL=Qdrant/clip-ViT-B-32-visual
EMBEDDING_BATCH_SIZE=32
PHASH_THRESHOLD=8
SIMILARITY_THRESHOLD=0.95
FACE_SIMILARITY_THRESHOLD=0.80
